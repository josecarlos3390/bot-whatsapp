# Entorno
APP_ENV=dev
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
# Para WhatsApp real, usa una URL pública HTTPS (ej. https://api.tudominio.com):
# el link de pago debe abrirse desde el teléfono del cliente.
ADMIN_TOKEN=

# Base de datos / cola
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot
REDIS_URL=redis://localhost:6379/0
QUEUE_ENABLED=false
AUTO_CREATE_DB=true
KNOWLEDGE_DIR=knowledge
BOT_NAME=Rohi
WEATHER_ENABLED=true
WEATHER_CITY=Santa Cruz
WEATHER_LATITUDE=-17.7833
WEATHER_LONGITUDE=-63.1821
SAP_EVENT_QUEUE_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
SAP_EVENT_EXCHANGE=sap.events
SAP_EVENT_QUEUE=chatbot.sap.events
SAP_EVENT_TENANT=RETAIL_QA5

# WhatsApp Cloud API
# Número de negocio (referencia; el envío usa WA_PHONE_NUMBER_ID).
WA_BUSINESS_NUMBER=+591XXXXXXXXX
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=dev-verify-token
WA_GRAPH_VERSION=v23.0
# true = no llama a Meta, sólo registra los envíos en logs (útil para demo)
WA_DRY_RUN=true
WA_NATIVE_CATALOG_ENABLED=false
WA_NATIVE_CART_ENABLED=false
WA_CATALOG_ID=
WA_COMMERCE_ACCOUNT_ID=
META_CATALOG_LINK_BASE=
META_CATALOG_PLACEHOLDER_IMAGE=https://placehold.co/600x600/EEEEEE/333333/png?text=ROHO
PRODUCT_IMAGE_PLACEHOLDER=https://placehold.co/600x600/EEEEEE/333333/png?text=ROHO
FEEDBACK_AFTER_CHECKOUT=false
FEEDBACK_DELAY_DAYS=2
FEEDBACK_OUTBOUND_ENABLED=false
FEEDBACK_TEMPLATE_NAME=encuesta_atencion
FEEDBACK_TEMPLATE_LANG=es
HANDOFF_WEBHOOK_URL=
HANDOFF_NOTIFY_ENABLED=true
HANDOFF_AUTO_RESUME_MINUTES=5
HANDOFF_SLA_MINUTES=5
HANDOFF_REASSIGN_MINUTES=5
ADVISOR_SESSION_SECRET=cambiar-en-produccion
ADVISOR_SESSION_HOURS=12
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# DeepSeek (si está vacío, el agente usa el modo demo determinista)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# SAP Business One
# mock = catálogo local; service_layer = directo; paas = integration-paas
SAP_MODE=paas
SAP_SL_URL=https://sap-host:50000/b1s/v1
SAP_PAAS_URL=http://127.0.0.1:5050
SAP_PAAS_API_KEY=
SAP_PAAS_TENANT=RETAIL_QA5
SAP_COMPANY_DB=RETAIL_QA5
SAP_USER=
SAP_PASSWORD=
SAP_VERIFY_TLS=true
SAP_WAREHOUSE=101-1001
SAP_PRICE_LIST=1
SAP_CASH_ACCOUNT=
# Lectura en vivo con caché corta. Escritura desactivada hasta validar QA.
SAP_LIVE_READS=true
SAP_WRITE_ENABLED=false
SAP_CACHE_TTL_SECONDS=60
# Dimensiones contables (Chile). Confirmar con el contador antes de producción.
SAP_COSTING_CODE=
SAP_COSTING_CODE2=
SAP_COSTING_CODE3=
SAP_TAX_CODE=
SAP_STORES=101-1001=Tienda 1,102-1001=Tienda 2,103-1001=Tienda 3
SAP_PRICE_CACHE_TTL_SECONDS=300
# Socio genérico ("Consumidor Final") para clientes sin RUT ni CardCode.
# Sin este valor el checkout exige identificar al cliente en SAP.
SAP_DEFAULT_CARD_CODE=
# Búsqueda en caliente: si el término no está en el catálogo local se consulta
# SAP y el resultado se guarda en la base del bot.
SAP_HOT_SEARCH_ENABLED=true
SAP_HOT_SEARCH_LIMIT=8

# Pagos (mock_qr | cucu_qr)
PAYMENT_PROVIDER=mock_qr
PAYMENT_TTL_MINUTES=30

# QR Simple de CUCU (Bolivia). Pide una API key sandbox en
# https://docs.cucu.bo/payments/cobros-qr/introduccion
CUCU_API_KEY=
CUCU_BASE_URL=https://qrsimple.cucu.bo/api/v1
CUCU_EXPIRATION=30m
CUCU_WEBHOOK_SECRET=
MEMORY_AUTO_SUMMARY=true

# Seed de catálogo de demostración
SEED_DEMO=true

# Barrido de handoffs (segundos) y tiempo máximo que un asesor puede tener un caso tomado
HANDOFF_SWEEP_SECONDS=300
HANDOFF_TAKEN_TIMEOUT_MINUTES=120
